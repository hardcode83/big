#cloud-config
# cloud-init de la instancia dev. Fuente de verdad del arranque de una VM NUEVA:
#  - Docker + Compose vía el repo APT OFICIAL de Docker (arm64) — docker-compose-plugin NO
#    está en los repos por defecto de Ubuntu 22.04 (bug histórico). $RELEASE/$KEY_FILE los
#    sustituye cloud-init (no son interpolaciones de Terraform).
#  - Runner self-hosted de GitHub Actions (label `dev`) para el CD (change app-deploy-dev, R7).
# Sobre la VM viva no se aplica por Terraform (metadata ForceNew + ignore_changes): se ejecutan
# los mismos pasos a mano una vez (ver RUNBOOK).
package_update: true
apt:
  sources:
    docker:
      source: "deb [arch=arm64 signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-buildx-plugin
  - docker-compose-plugin
  - python3-pip
write_files:
  - path: /etc/autohostai-runner.env
    permissions: '0644'
    content: |
      GITHUB_REPO=${github_repo}
      PAT_SECRET_OCID=${pat_secret_ocid}
  - path: /opt/bootstrap-runner.sh
    permissions: '0755'
    content: |
      ${indent(6, runner_bootstrap)}
runcmd:
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
  - pip3 install --quiet oci-cli
  - /opt/bootstrap-runner.sh
