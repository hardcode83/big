# Plantilla de entorno del DEPLOY dev (consumida por docker-compose.deploy.yml).
# NO poner valores reales aquí. El CD (deploy-dev.yml) renderiza el .env real en la VM
# desde GitHub Secrets en cada deploy, validando que ninguna clave falte. [R4]
#
# Las NEXT_PUBLIC_* NO van aquí: se hornean en el build como build-args (Next standalone),
# ver .github/workflows/deploy-dev.yml.

# --- Imagen a desplegar (las escribe el CD) ---
IMAGE_TAG=            # p. ej. sha-<commit-sha>
GHCR_NS=             # namespace GHCR (owner del repo)

# --- Postgres (solo red interna del compose; el puerto 5432 no se publica) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Backend ---
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# --- Frontend (server-side, runtime) ---
BACKEND_INTERNAL_URL=   # default http://backend:8000 si se omite
