# Plantilla de entorno del DEPLOY dev (consumida por docker-compose.deploy.yml).
# NO poner valores reales aquí. El CD (deploy-dev.yml) renderiza el .env real en la VM en cada
# deploy leyendo los secrets del **OCI Vault** por instance principal (generados por Terraform),
# validando que ninguna clave falte. [R4/R8]
#
# Las NEXT_PUBLIC_* NO van aquí: se hornean en el build como build-args (Next standalone).

# --- Imagen a desplegar (las escribe el CD) ---
IMAGE_TAG=            # p. ej. sha-<commit-sha>
GHCR_NS=             # namespace GHCR (owner del repo)

# --- Postgres (solo red interna del compose; el puerto 5432 no se publica) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Backend ---
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# --- Frontend (server-side, runtime) ---
BACKEND_INTERNAL_URL=   # default http://backend:8000 si se omite

# --- Ingress HTTPS: Cloudflare Tunnel (change ingress-https-dev) ---
# Lo renderiza el CD leyéndolo del OCI Vault por instance principal, resolviendo el secreto POR
# NOMBRE (autohostai-<env>-cloudflare-tunnel-token). Lo genera Terraform derivándolo del túnel;
# nunca se copia del dashboard de Cloudflare. El API token del provider NO llega a esta máquina.
TUNNEL_TOKEN=

# --- Bootstrap de los usuarios iniciales (change auth-tenancy) ---
# NO se ponen aquí ni en el .env que escribe el workflow: son contraseñas que elige una
# persona, así que no encajan en el patrón random_* + Vault del resto de secretos, y el
# workflow reescribe este .env en cada deploy. Se pasan una sola vez en la propia
# invocación del comando — procedimiento completo en
# infra/environments/dev/RUNBOOK.md §6.5:
#   docker compose -f docker-compose.deploy.yml exec \
#     -e BOOTSTRAP_TENANT_NAME=... [...] backend python -m app.cli.bootstrap
