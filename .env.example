# Copy to .env (make up does this automatically if .env is missing).
# Never commit .env (see .gitignore).
#
# Postgres/local-dev values below are safe working defaults, not secrets —
# this DB only exists inside the docker-compose network, unreachable from
# outside localhost, with no real data. Change them if you want, but the
# defaults are enough to run `make up` with zero edits.
#
# Real secrets (future: PMS/WhatsApp/Email/SES.Hospedajes credentials, JWT
# signing key) must NEVER get a default here — names only, per
# sdd/steering/security.md #8, and must fail fast if unset.

# --- Postgres (consumed by the postgres service + future backend DB connection) ---
POSTGRES_DB=autohostai      # any value works — just the DB name inside the container
POSTGRES_USER=autohostai    # any value works
POSTGRES_PASSWORD=localdev  # any value works — not a real secret, change freely

# --- Client-exposed (Next.js NEXT_PUBLIC_* are bundled into the browser build) ---
NEXT_PUBLIC_APP_ENV=local   # any label works, purely informational today

# REDIS_URL and BACKEND_INTERNAL_URL are NOT here on purpose: they're fixed by
# the docker-compose network topology (always redis://redis:6379/0 and
# http://backend:8000), not something a developer configures — see
# docker-compose.yml's `environment:` per service.
