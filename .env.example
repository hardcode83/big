# Copy to .env and fill in real values. Never commit .env (see .gitignore).
# Names only here per sdd/steering/security.md #8 — no real values in this file.

# --- Postgres (consumed by the postgres service + future backend DB connection) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Redis (broker/backend for Celery) ---
# format: redis://redis:6379/0
REDIS_URL=

# --- Server-only: internal service-to-service URLs (docker-compose network) ---
# format: http://backend:8000
BACKEND_INTERNAL_URL=

# --- Client-exposed (Next.js NEXT_PUBLIC_* are bundled into the browser build) ---
NEXT_PUBLIC_APP_ENV=
