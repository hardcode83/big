# Copy to .env (make up does this automatically if .env is missing).
# Never commit .env (see .gitignore).
#
# Postgres/local-dev values below are safe working defaults, not secrets —
# this DB only exists inside the docker-compose network, unreachable from
# outside localhost, with no real data. Change them if you want, but the
# defaults are enough to run `make up` with zero edits.
#
# Real secrets (future: PMS/WhatsApp/Email/SES.Hospedajes credentials, JWT
# signing key) must NEVER get a default here — names only, per
# sdd/steering/security.md #8, and must fail fast if unset.

# --- Postgres (consumed by the postgres service + future backend DB connection) ---
POSTGRES_DB=autohostai      # any value works — just the DB name inside the container
POSTGRES_USER=autohostai    # any value works
POSTGRES_PASSWORD=localdev  # any value works — not a real secret, change freely

# --- Auth (change auth-tenancy) ---
# JWT signing key: no default here on purpose. `make up` generates one with
# `openssl rand -hex 32` into your local .env if this is missing or empty, so the
# value lives on your machine and never in the repo. docker-compose.yml uses `:?`,
# so a hand-rolled .env without it fails loudly instead of signing with nothing.
JWT_SECRET_KEY=
# Optional overrides — the defaults in app/core/config.py match PRD §22:
# JWT_ACCESS_TOKEN_MINUTES=15
# JWT_REFRESH_TOKEN_DAYS=7

# --- Encryption at rest (change pms-provider-resolution) ---
# Fernet key for secrets stored in the database — PMS provider credentials today
# (rule 3 of sdd/steering/security.md). No default here either, and for a sharper
# reason than the signing key: a committed key would make every ciphertext in every
# clone readable, which is worse than cleartext because the column reads as protected.
#
# NOT the same shape as JWT_SECRET_KEY: Fernet wants base64url of 32 bytes, so
# `openssl rand -hex 32` produces something the app rejects at startup. `make up`
# generates a valid one into your local .env with:
#   openssl rand 32 | base64 | tr '+/' '-_'
ENCRYPTION_KEY=
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# LOGIN_MAX_FAILED_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15
# BCRYPT_ROUNDS=12
#   Careful: changing this on a database that already has users reopens the login
#   timing oracle of R1.4 until every stored hash is rebuilt at the new cost, because
#   the dummy hash burned on failed logins carries the CONFIGURED cost while a real
#   verification carries the one stored with the user. See docs/auth-tenancy.md.
# BCRYPT_MAX_CONCURRENCY=
#   How many password hashes may run at once. Empty = the visible CPU count, which is
#   the right answer on both a laptop and the 4-OCPU dev VM. Hashing is CPU-bound and
#   runs in worker threads, so this is the login endpoint's CPU budget: raising it
#   above the core count makes every login slower without serving one more request.
# Límites de la importación de reservas por CSV (`POST /api/v1/integrations/pms/import-csv`).
# Ambos se comprueban ANTES de parsear: un fichero enorme se rechaza con 413, no se carga en
# memoria primero. El de bytes es la regla 6 de sdd/steering/security.md (default 10 MB); el de
# filas existe porque un fichero pequeño puede traer un millón de líneas.
# CSV_IMPORT_MAX_BYTES=10485760
# CSV_IMPORT_MAX_ROWS=1000

# Tope de una foto de limpieza (`POST /api/v1/cleaning-tasks/{id}/photos`, change
# `cleaning-photos-storage`). Misma regla 6 de sdd/steering/security.md y mismo default de
# 10 MB que el CSV, pero variable propia: un import CSV lo dimensiona cuántas reservas pega
# una persona, y una foto lo dimensiona la cámara de un móvil.
#
# Se comprueba DOS VECES y las dos hacen falta, pero NO a partes iguales: quien cumple R2.5
# es el contador acumulativo del middleware, también frente a un cliente que miente en
# `Content-Length` o usa `Transfer-Encoding: chunked`. El conteo por trozos del caso de uso
# acota la copia en memoria y cubre a los llamantes sin middleware delante. El razonamiento
# completo vive en un solo sitio: el docstring de
# `UploadCleaningPhotoUseCase._read_within_limit`.
#
# NO resuelvas «la foto no cabe» subiendo `REQUEST_MAX_BYTES` ni el techo JSON de 1 MiB de
# las rutas `/cleaning-`: eso se lo quita a TODAS ellas y reabre el agujero medido
# (un POST anónimo de ~50 MB a `/cleaning-checklist-templates` leído entero antes del 401).
# Esta variable existe justamente para no tener que tocar aquéllas.
# PHOTO_UPLOAD_MAX_BYTES=10485760

# Entrega de notificaciones (change `access-notifications`). Sin credenciales: los adapters
# del MVP son consola y mocks (PRD §14); las claves reales de WhatsApp/SMTP las reserva la
# regla 8 de sdd/steering/security.md y llegan con `hardening-release`.
# El tope de intentos es lo que acota los duplicados: el emisor registra el intento ANTES de
# llamar al adapter, así que un proceso que muera a mitad reenvía hasta ese techo y no más.
# No hay ajuste de backoff a propósito — `notification_logs` no tiene columna de «próximo
# intento» y añadirla para un logger de consola sería esquema inventado por adelantado.
# NOTIFICATION_MAX_ATTEMPTS=3
# NOTIFICATION_BATCH_SIZE=100

# Tope de cuerpo para TODO LO DEMÁS bajo `/api/v1/` (change `api-ingress-routing`, R7).
# Son cuerpos JSON, así que es dos órdenes de magnitud más pequeño que el del CSV a
# propósito, y se comprueba ANTES de leer el cuerpo — como el de arriba.
#
# NO LA SUBAS, y menos «temporalmente para probar algo»: es la única cosa que impide que
# un llamante anónimo de internet agote la memoria de la máquina antes de que el límite de
# 10 intentos/min se consulte siquiera. Medido en el entorno desplegado antes de existir:
# un solo POST de 400 MB a `/api/v1/auth/login` llevó el backend de 195 MiB a 1,016 GiB de
# RSS, porque FastAPI lee el cuerpo antes de resolver dependencias. Ningún compose limita
# la memoria del contenedor, así que el techo es el de la VM.
# REQUEST_MAX_BYTES=1048576

# Los dos límites del receptor de webhooks del PMS (`POST /api/v1/webhooks/{provider}/{token}`,
# change `reservations-webhooks`, regla 12(c) de sdd/steering/security.md). Son dos y no uno
# porque defienden de cosas opuestas, y un solo número no puede servir a las dos.
#
# El de ENTREGA va por token —es decir, por tenant— y es generoso: protege la tabla del tráfico
# legítimo desbocado de un proveedor, y su radio de daño es un solo tenant.
#
# El de SONDEO va por IP y sólo cuenta las peticiones que **fallan** la autenticación: es lo que
# hace que adivinar una ruta cueste algo. Cuenta fallos y no peticiones a propósito — un proveedor
# envía desde pocas IPs en nombre de MUCHOS tenants, así que un límite por IP sobre el tráfico
# bueno los estrangularía a todos a la vez.
#
# No hay `WEBHOOK_MAX_BODY_BYTES`: el tope de cuerpo ya lo pone `REQUEST_MAX_BYTES` de arriba,
# aplicado a todo `/api/v1/` antes del enrutado.
# WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# WEBHOOK_PROBE_LIMIT_PER_MINUTE=20

# El portal del huésped (`/api/v1/guest/{acción}/{token}`, change `guest-portal-api`).
# Ninguna de las cuatro es secreta, así que las cuatro llevan defecto.
#
# GRACE_DAYS es toda la vigencia del token: no hay columna `expires_at`, la ventana se deriva
# en cada petición como «hasta medianoche UTC de `check_out_date` + estos días». Derivarla en
# vez de guardarla es lo que hace que una estancia que se mueve —o que se cancela— surta efecto
# al instante y no en el siguiente barrido. La medianoche es UTC y no la de la propiedad: con
# dos días de gracia el desfase máximo son 2 horas sobre 48, y usar la zona de la propiedad
# obligaría a leerla antes de saber de qué tenant es la petición.
#
# Otros dos son los límites de tasa, asimétricos a propósito. El de TOKEN es generoso y se cobra
# **después** de autorizar; será lo único que acote cuántas incidencias produce una estancia
# cuando §7 añada `POST /guest/incident`, que no es idempotente, y hasta entonces acota las tres
# rutas que hay. El de SONDEO va por IP, sólo cuenta las autorizaciones que **fallan**, y se
# pregunta antes de cualquier consulta: es lo que hace que adivinar un token cueste. Por IP y no
# por token porque una autorización fallida no tiene token por el que contar; y no un único
# límite global porque el WiFi de un hotel pone a todos sus huéspedes detrás de una sola
# dirección. Ojo con «antes de cualquier consulta»: en el `POST`, el cuerpo se valida antes de
# que la ruta empiece, así que un cuerpo malformado es un `422` que no gasta presupuesto.
# Límite conocido del de SONDEO: sólo lo alimentan los fallos, pero se consulta en TODA
# petición, así que agotado el presupuesto de una dirección un huésped con token bueno detrás
# del mismo NAT recibe 429 hasta que acabe la ventana. Es el orden que fijó el panel de §5 y el
# que ya lleva el receptor de webhooks; anotado en design.md D6 como candidato de roadmap.
# GUEST_PORTAL_TOKEN_GRACE_DAYS=2
# GUEST_PORTAL_RATE_LIMIT_PER_MINUTE=60
# GUEST_PORTAL_PROBE_LIMIT_PER_MINUTE=20

# A dónde se le dice al huésped que pida ayuda: texto libre (teléfono, dirección o URL), que el
# portal sólo renderiza. Constante de configuración y no una fila de la base de datos, porque
# leer un contacto de soporte de ahí estaría a un join de exponer a quien lo atiende, y esto se
# sirve a internet abierta. Sin valor: el campo se sirve como `null` y el portal no enseña la
# tarjeta de ayuda, que es lo honesto para una instalación que aún no ha elegido uno.
# GUEST_PORTAL_SUPPORT_CHANNEL=

# DO NOT ADD `FORWARDED_ALLOW_IPS` HERE, and especially not `FORWARDED_ALLOW_IPS=*`.
# uvicorn falls back to that variable when its `--forwarded-allow-ips` flag is absent
# (uvicorn/config.py:356), and it decides WHO is believed about a client's address — which
# is who gets counted by the 10-attempts/min login limit and what lands in
# audit_logs.actor_ip. This service receives the whole file via `env_file`, and its port
# 8000 is published on every interface, so `*` would let anyone on your network hand
# themselves a fresh login budget on every request. The flag is pinned in
# backend/devops/Dockerfile precisely so this variable cannot take effect; the deployed
# environment widens it through the `command:` of docker-compose.deploy.yml and nowhere else.

# No variable for the real-client-IP header, on purpose (change `api-ingress-routing`).
# Resolving it belongs to uvicorn, whose `--forwarded-allow-ips` names the ONE peer
# allowed to report a client address; `docker-compose.deploy.yml` passes it the frontend
# container's static address. Nothing to set here, in any environment: locally the
# backend port is published on every interface for mobile testing, so trusting a
# forwarding header would let anyone on the LAN pick their own rate-limit bucket.
# See docs/auth-tenancy.md.

# --- Channex staging (change `channex-staging-adapter`) ---
# Only `python -m app.integrations.cli.pms_sync <tenant> --provider channex` reads these;
# the application itself never does, and the command defaults to the mock adapter.
#
# Name only, no value: it is a real provider credential (steering/security.md #8). Create it
# in the Channex panel under Organisation -> API Keys. The command aborts naming this variable
# if you select `--provider channex` without it, rather than falling back to the mock — a
# silent fallback reports "created 0" and looks exactly like an empty sync.
#
# NOTE this key is NOT governed by rule 3 (Fernet at rest): that rule covers provider
# credentials "que no viva[n] en el entorno", and this one does. The encrypted credentials that
# live in the database arrived with `pms-provider-resolution` (table `pms_credentials`), and are
# provisioned with `python -m app.integrations.cli.pms_credentials`.
CHANNEX_API_KEY=
# Defaults to STAGING on purpose (app/core/config.py). This adapter is a dev/validation tool —
# ADR 0006 keeps Beds24 as the MVP provider — so a misconfiguration must land on staging and
# never on a live Channex account wired to real OTA listings.
# CHANNEX_BASE_URL=https://staging.channex.io/api/v1

# --- Beds24 measurement spike (change `pms-beds24-spike`) ---
# Only `scripts/beds24_probe.py` and `scripts/beds24_webhook_sink.py` read these. Neither the
# application nor `app/core/config.py` knows they exist: this change measures the provider, it
# does not integrate it. The `Beds24Adapter` and its per-property credentials arrive with
# `pms-beds24-adapter`.
#
# Name only, no value (steering/security.md #8). Obtain it in the Beds24 panel: invite code ->
# refresh token. The probe exchanges it for a 24 h access token at startup and keeps that token
# in memory only — it is never written to disk.
#
# NOTE this is an ACCOUNT-level credential, not a per-property one: ADR 0006 records that a
# Beds24 refresh token grants write access over EVERY property in the account. It is the more
# dangerous kind, not the less. Rule 3 (Fernet at rest) does not govern it because it lives in
# the environment, which is exactly what that rule excludes; rule 8 governs it instead.
BEDS24_REFRESH_TOKEN=
# The API V2 base. Left commented: the probe refuses to talk to any host outside its hardcoded
# allowlist, so overriding this cannot redirect it somewhere else.
# BEDS24_BASE_URL=

# The static header Beds24 sends with each webhook, which is the ONLY authentication it offers
# in place of a signature — rule 12(a) treats it as a credential, so name only, never a value.
# Format is a full header line, e.g. `X-AutoHost-Probe: 1`. Read by
# `scripts/beds24_probe.py webhook`; deliberately NOT accepted as a command-line flag, where it
# would survive in shell history and `ps`.
BEDS24_WEBHOOK_SECRET=

# --- Beds24 adapter, operational knobs (change `pms-beds24-adapter`) ---
# NO CREDENTIAL HERE, and that is the point. The adapter reads its refresh token from the
# encrypted `pms_credentials` table (rule 3), never from the environment — `BEDS24_REFRESH_TOKEN`
# above stays what it always was: the measurement bench's, governed by rule 8. Two homes for one
# credential is how one of them stops being rotated.
#
# There is no `BEDS24_BASE_URL` for the application either: the base URL and the host allowlist
# are constants in `app/integrations/infrastructure/beds24/client.py`. Beds24 has no staging
# environment, so the reason `CHANNEX_BASE_URL` is configurable does not exist here, and a
# configurable destination for an account-wide credential is a lever with no use case.
#
# All three have working defaults; uncomment only to tune.
# BEDS24_MAX_PAGES=50
# BEDS24_PAGE_LIMIT=100
# BEDS24_TIMEOUT_SECONDS=30.0

# --- Bootstrap of the initial tenant and users (`make bootstrap`) ---
# Names only, no values: these are real user passwords (steering/security.md #8,
# requirement R7.4). `make bootstrap` fails fast until you fill them in, and it is
# NOT part of `make up`.
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_BILLING_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_MANAGER_NAME=
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=

# --- Client-exposed (Next.js NEXT_PUBLIC_* are bundled into the browser build) ---
NEXT_PUBLIC_APP_ENV=local   # any label works, purely informational today

# REDIS_URL and BACKEND_INTERNAL_URL are NOT here on purpose: they're fixed by
# the docker-compose network topology (always redis://redis:6379/0 and
# http://backend:8000), not something a developer configures — see
# docker-compose.yml's `environment:` per service.
