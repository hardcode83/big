# env / secrets
# Broad on purpose: `make up` rewrites .env through a temporary file, and any
# stray copy (.env.tmp, .env.bak, .env.save from an editor) would hold the JWT
# signing key and the bootstrap passwords in cleartext.
.env*
!.env.example
!.env.deploy.example

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# node / next.js
node_modules/
.next/
dist/
build/
npm-debug.log*

# editors / OS
.DS_Store
.vscode/
.idea/

# SDD usage metrics
.sdd-usage/

# Terraform (el lock file .terraform.lock.hcl SÍ se versiona, a propósito)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/*.tfvars.example
# Credenciales de backend/state: ignora TODO .hcl (incluidos typos como backekn.hcl)
# salvo el lock file (versionado a propósito). Los .example terminan en .example, no en .hcl.
**/*.hcl
!**/.terraform.lock.hcl
# Claves privadas y logs — nunca al repo
*.pem
**/*.log
# Helper de bootstrap manual de capacidad A1 — local-only: el pipeline es el camino canónico
# para operar infra. Re-ejecutarlo sobre la máquina existente es destructivo (itera ad_number con -auto-approve).
infra/environments/dev/apply_loop.sh
